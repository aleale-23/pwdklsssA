<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN"
  "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd"> 
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="id" lang="id">
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
  <title>Formulir Registrasi Data Mahasiswa</title>

  <style type="text/css">
    body {
      font-family: 'Poppins', sans-serif;
      background: linear-gradient(135deg, #4facfe, #00f2fe);
      margin: 0;
      padding: 0;
      color: #333;
    }

    h1 {
      text-align: center;
      color: white;
      background-color: rgba(0, 0, 0, 0.3);
      padding: 20px;
      border-radius: 8px;
      margin-top: 20px;
    }

    
    form {
      width: 70%;
      max-width: 700px;
      margin: 30px auto;
      background-color: white;
      padding: 25px 40px;
      border-radius: 12px;
      box-shadow: 0 5px 15px rgba(0,0,0,0.2);
    }

    
    fieldset {
      border: 2px solid #4facfe;
      border-radius: 10px;
      margin-bottom: 20px;
      padding: 20px;
      background-color: #f9f9f9;
    }

    legend {
      font-weight: bold;
      font-size: 18px;
      color: #0078ff;
    }

    
    label {
      font-weight: 600;
      display: block;
      margin-bottom: 8px;
    }

    input[type="text"],
    input[type="email"],
    input[type="date"],
    select {
      width: 100%;
      padding: 8px 10px;
      border: 1px solid #ccc;
      border-radius: 6px;
      font-size: 15px;
      margin-bottom: 15px;
      transition: border-color 0.3s;
    }

    input[type="text"]:focus,
    input[type="email"]:focus,
    input[type="date"]:focus,
    select:focus {
      border-color: #0078ff;
      outline: none;
    }

    
    input[type="radio"] {
      margin-right: 6px;
    }

    label[for="with"], label[for="without"] {
      display: inline-block;
      margin-right: 15px;
      font-weight: normal;
    }

    
    input[type="submit"] {
      width: 100%;
      padding: 12px;
      font-size: 16px;
      font-weight: bold;
      color: white;
      background-color: #0078ff;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      transition: background-color 0.3s;
    }

    input[type="submit"]:hover {
      background-color: #005ecb;
    }

    
    @media (max-width: 600px) {
      form {
        width: 90%;
        padding: 20px;
      }
    }
  </style>
</head>

<body>
  <h1>Reservation Hotel Room</h1>

  <form action="/action_page.php">
    <fieldset>
      <legend>Personal Data</legend>
      <label for="name">1. Name</label><br />
      <input type="text" id="name" name="name" /><br /><br />
      
      <label for="gender">2. Gender</label><br />
      <input type="text" id="gender" name="gender" /><br /><br />
      
      <label for="email">3. Email Address</label><br />
      <input type="email" id="email" name="email" /><br /><br />
      
      <label for="phone">4. Telp Number</label><br />
      <input type="text" id="phone" name="phone" /><br /><br />
    </fieldset>

    <fieldset>
      <legend>Reservation Room Form</legend>
      <label for="bname">1. Reservation Name</label><br />
      <input type="text" id="bname" name="bname" /><br /><br />
      
      <label for="bdate">2. Booking Date</label><br />
      <input type="date" id="bdate" name="bdate" /><br /><br />
      
      <label for="type">3. Room Type</label><br />
      <select name="type">
        <option>Deluxe</option>
        <option>Reguler</option>
      </select><br /><br />
      
      <label for="btype">4. Bed Type</label><br />
      <select name="btype">
        <option>Single Bed</option>
        <option>King Size</option>
      </select><br /><br />
      
      <label for="breakfast">5. Breakfast</label><br /><br />
      <label for="with">
      <input type="radio" id="with" name="breakfast" />with breakfast
      </label>
      <label for="without">
      <input type="radio" id="without" name="breakfast" />without breakfast
      </label>
      <br /><br />
    </fieldset>

    <fieldset>
      <legend>Payment</legend>
      <label for="checkin">1. Check-In Date</label><br />
      <input type="date" id="checkin" name="checkin" /><br /><br />
      
      <label for="checkout">2. Check-Out Date</label><br />
      <input type="date" id="checkout" name="checkout" /><br /><br />
      
      <label for="pay">3. Payment Method</label><br />
      <select name="pay">
        <option>Cash</option>
        <option>Transfer</option>
      </select><br /><br />
    </fieldset>

    <input type="submit" value="Submit" />
  </form>
</body>
</html>
